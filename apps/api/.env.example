# Required for Drizzle + tenant-scoped queries.
# Supabase → Project Settings → Database → Connection string → URI
# Paste the FULL string from the dashboard (do not leave [PROJECT-REF], [REGION], or [YOUR-PASSWORD]).
# If the password has [ ] # @ etc., URL-encode them (e.g. [ → %5B).
# Session pooler example (Nest/Drizzle-friendly). Replace REGION with your project region
# (aesthetic is ca-central-1). Prefer pooler if db.<ref>.supabase.co fails with ENOTFOUND.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Without Redis, the API uses an in-memory cache for local development.
REDIS_URL=redis://localhost:6379

# Set true only for local/staging so POST /api/v1/auth/bootstrap-tenant works.
ALLOW_TENANT_BOOTSTRAP=true

# Private Supabase Storage bucket for photos/consents
SUPABASE_MEDIA_BUCKET=patient-media

WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Hosted API: keep this small so instances do not exhaust the Supabase pooler.
# PG_POOL_MAX=5
